{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chi-Ro Heirs",
  "version": "0.2.0",
  "identifier": "com.chiroheirs.lector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chi-Ro Heirs",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#121110",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lector bíblico personal, ligero y local",
    "longDescription": "Chi-Ro Heirs: NTV y NLT desde la API oficial de Tyndale, versiones de dominio público sin conexión, subrayado, notas enlazadas, estudio de palabras, referencias cruzadas y memorización.",
    "copyright": "Código © 2026. Textos bíblicos según sus licencias.",
    "resources": {
      "../datos/biblias.db": "biblias.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
