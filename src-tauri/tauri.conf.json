{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chi-Ro Heirs",
  "version": "0.14.3",
  "identifier": "com.chiroheirs.lector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chi-Ro Heirs",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#f7f7f5",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lector bíblico personal, ligero y local",
    "longDescription": "Chi-Ro Heirs: NTV y NLT desde la API oficial de Tyndale, versiones de dominio público sin conexión, subrayado, notas enlazadas, estudio de palabras, referencias cruzadas y memorización.",
    "copyright": "Código © 2026. Textos bíblicos según sus licencias.",
    "resources": {
      "../datos/biblias.db": "biblias.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "./instalador/dmg-fondo.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 350,
          "y": 236
        },
        "applicationFolderPosition": {
          "x": 546,
          "y": 236
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "headerImage": "./instalador/nsis-cabecera.bmp",
        "sidebarImage": "./instalador/nsis-lateral.bmp",
        "installerIcon": "./icons/icon.ico",
        "languages": [
          "Spanish",
          "English"
        ]
      },
      "wix": {
        "bannerPath": "./instalador/msi-banner.bmp",
        "dialogImagePath": "./instalador/msi-dialogo.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDOUY3RjAxQzdERjRBQzUKUldURlN0L0hBWCtmZk9MTndzUk9JTFEwSE5VckwwSDI3dlYrNjBHci9tV0M0aGc1LzkvN2FETHgK",
      "endpoints": [
        "https://github.com/XristosKidonis/chi-ro-heirs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
