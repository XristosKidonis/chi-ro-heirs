{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.nlt.to/*" }]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "opener:default"
  ]
}
